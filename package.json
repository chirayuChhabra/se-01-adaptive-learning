{
  "name": "se-01",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "models": "node --env-file-if-exists=.env teacher/author-chapter/list-models.ts",
    "author": "node --env-file-if-exists=.env teacher/author-chapter/generate.ts",
    "validate": "node teacher/build/validate.ts",
    "build": "node teacher/build/build.ts",
    "bundle:runtime": "node teacher/build/bundle-runtime.ts",
    "serve": "node teacher/build/serve.ts",
    "test": "node --test",
    "build:learning": "node teacher/build/build.ts content/reader-demo dist/learning",
    "serve:learning": "node scripts/serve-learning.ts",
    "build:e2e": "node e2e-playground/build.ts",
    "serve:e2e": "node scripts/serve-learning.ts dist/e2e-playground",
    "e2e": "node e2e-playground/build.ts && node scripts/serve-learning.ts dist/e2e-playground"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "unpdf": "^2.1.0"
  },
  "bin": {
    "compile": "./compiler/cli.ts"
  }
}
